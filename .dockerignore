# Keep build contexts small and free of secrets and local data.
.git
.env
.env.*
.venv
**/node_modules
**/dist
**/__pycache__
.pytest_cache
.ruff_cache
data
models
demos
# Of the documentation, the API image takes what the method page shows as it is: the
# probe campaign (guides, report, figures) and the note on the LLM review.
docs/*
!docs/probes
!docs/review.md
tests
.local
.claude
.cursor
