# Copy to .env (git-ignored). Never commit real values.

# --- Hostinger ---
# API token (VPS, firewall, DNS): https://hpanel.hostinger.com/profile/api
HOSTINGER_API_TOKEN=
# AI Router: OpenAI- and Anthropic-compatible gateway. Keys start with "sk-hstgr-".
# Key and model ids: Hostinger dashboard -> AI Router. One key for development, one for the server.
HOSTINGER_ROUTER_API_KEY=
HOSTINGER_ROUTER_API_KEY_PROD=
HOSTINGER_ROUTER_API_BASE=https://router.hostinger.com/v1

# --- Embedding role (docs/tech-challenge-plan.md, section 2) ---
# Local mode: an Ollama endpoint running EmbeddingGemma. The defaults suit a laptop.
# EMBEDDING_API_BASE=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=embeddinggemma:300m-qat-q8_0
# First 12 hex of the model digest reported by Ollama. Written by `pipelines.embed`.
EMBEDDING_REVISION=
# EMBEDDING_PREFIX=task: classification | query:
# EMBEDDING_DIMS=256

# --- LLM role: the AI Router. The model id is read from the dashboard, never guessed. ---
# LLM_MODEL=

# --- Server only (the .env beside the stack on the VPS) ---
# NOISEMAP_HOST=noisemap.example.org
# NOISEMAP_TAG=<commit the running images were built from; written by deploy/up.sh>

# --- Local development ---
# The map build the API serves (default: data/build/current).
# DATA_BUILD_DIR=data/build/current

# --- Tech challenges ---
# Verda: Console -> Credentials -> Cloud API credentials.
# VERDA_CLIENT_ID=
# VERDA_CLIENT_SECRET=
# Context.dev: https://context.dev/dashboard/api-keys
# CONTEXT_DEV_API_KEY=
# Google AI Studio, only if Gemini must be called directly instead of through the AI Router.
# GEMINI_API_KEY=
# CRACI API: Settings -> API tokens on platform.craci.com.
# CRACI_API_TOKEN=

# Optional: ElevenLabs, narration of the demo video (skills narrate and produce-video).
# ELEVENLABS_API_KEY=
