# Copy to .env (git-ignored). Never commit real values.

# Hostinger AI Router: OpenAI- and Anthropic-compatible gateway. Keys start with "sk-hstgr-".
# Key and model ids: Hostinger dashboard -> AI Router.
HOSTINGER_ROUTER_API_KEY=
HOSTINGER_ROUTER_API_BASE=https://router.hostinger.com/v1

# Optional: ElevenLabs, narration of the demo video (skills narrate and produce-video).
# ELEVENLABS_API_KEY=

# Optional: CRACI API (tech challenge "Best use of CRACI"). Settings -> API tokens on platform.craci.com.
# CRACI_API_TOKEN=
